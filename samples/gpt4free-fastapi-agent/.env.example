# Copy to .env and adjust as needed. All values are optional.

# Port the server listens on.
PORT=8000

# If set, callers must send "Authorization: Bearer <SAMPLE_API_KEY>".
# Leave unset to disable auth (fine for local-only use).
SAMPLE_API_KEY=

# Model used when a request omits "model".
DEFAULT_MODEL=gpt-4o-mini

# Force a specific g4f provider instead of letting g4f pick automatically.
DEFAULT_PROVIDER=
