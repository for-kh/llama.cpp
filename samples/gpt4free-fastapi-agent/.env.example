# Copy to .env and adjust as needed. All values are optional.
# No API key is required to run this server or reach the default provider.

# Port the server listens on.
PORT=8000

# If set, callers of *this* server must send
# "Authorization: Bearer <SAMPLE_API_KEY>". Leave unset (default) to
# disable auth entirely, e.g. for local-only use.
SAMPLE_API_KEY=

# Model used when a request omits "model". "openai-fast" is served by the
# Pollinations provider below and needs no account or API key.
DEFAULT_MODEL=openai-fast

# g4f provider to use. "Pollinations" is free and requires no auth. Set to
# empty to let g4f auto-select across all providers (some of which need
# their own API keys/accounts and will fail without them).
DEFAULT_PROVIDER=Pollinations
